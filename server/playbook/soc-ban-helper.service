[Unit]
Description=Pembantu root playbook ban IP Beruk Sakti (menjalankan ban/unban di jail beruk-playbook)
After=fail2ban.service
Wants=fail2ban.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/soc-ban-helper --daemon
User=root
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/soc-automation-dashboard
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectControlGroups=yes
MemoryMax=96M
